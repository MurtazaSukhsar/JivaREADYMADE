# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Admin login ---
# IMPORTANT: this must be base64-encoded, not a raw bcrypt hash. Next's env
# loader expands "$" in .env values as if it were a shell variable, which
# silently corrupts a raw hash like "$2a$10$...". Generate it like this:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password-here', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=

# Static access key for the admin panel — lets you open /admin?key=<value>
# from any device or network without going through the login form.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret. Rotate it if you believe it was ever exposed.
ADMIN_API_KEY=

# Any long random string (32+ characters). Used to sign the admin session
# cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Razorpay ---
# From the Razorpay dashboard → Settings → API Keys.
# Use the Test Mode keys until you're ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard → Settings → Webhooks, after you create a
# webhook pointing at https://your-domain.com/api/webhooks/razorpay
# with the "payment.captured" event enabled.
RAZORPAY_WEBHOOK_SECRET=

# --- Google Sheets (product catalog + orders) ---
# See the "Google Sheets setup" section in README.md for the full walkthrough
# (create a Google Cloud service account, share the sheet with it, add the
# Products/Orders tabs). Once you have the downloaded JSON key file:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('/path/to/downloaded-key.json')).toString('base64'))"
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# The ID from your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=
